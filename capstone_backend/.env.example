MONGO_URI=mongodb://localhost:27017/legalease

# Retrieval backend: hybrid is the clause-aware knowledge base (FAISS + BM25 +
# cross encoder). memory selects the pre-hybrid baseline used for benchmarking.
LEGALEASE_RETRIEVER=hybrid

LEGALEASE_EMBEDDING_MODEL=BAAI/bge-large-en-v1.5
LEGALEASE_RERANKER_MODEL=BAAI/bge-reranker-large
LEGALEASE_RERANK_TOP_K=5
LEGALEASE_BM25_K1=1.5
LEGALEASE_BM25_B=0.75

LEGALEASE_QA_MODEL=deepset/deberta-v3-base-squad2
LEGALEASE_NER_MODEL=nlpaueb/legal-bert-base-uncased

LEGALEASE_LLM_PROVIDER=none
LEGALEASE_LLM_MODEL=gpt-4.1-mini
LEGALEASE_LLM_API_KEY=
LEGALEASE_LLM_BASE_URL=
LEGALEASE_LLM_TIMEOUT=60
LEGALEASE_LLM_TEMPERATURE=0
LEGALEASE_LLM_MAX_TOKENS=700

LEGALEASE_TOP_K=5
LEGALEASE_CANDIDATE_POOL=25
LEGALEASE_MAX_CONTEXT_CHARS=9000
LEGALEASE_FAITHFULNESS_THRESHOLD=0.55
LEGALEASE_LOW_CONFIDENCE_THRESHOLD=0.45
LEGALEASE_MIN_ANSWER_CONFIDENCE=0.15
